{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boto",
  "version": "0.3.0",
  "identifier": "com.boto.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd ../.. build:daemon && bun run dev",
    "beforeBuildCommand": "bun run --cwd ../.. build:daemon && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Boto",
        "width": 1100,
        "minWidth": 960,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/botod"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NDQzMTNGODBGMTEzRkMKUldUOEUvR0FQekZFZEp0YlZIaUFnalBaNHppSWZ2b0VLQ1dSdVlvV25hZVE1M1llYzZMRUF6cHYK",
      "endpoints": ["https://github.com/fazedordecodigo/upbot/releases/latest/download/latest.json"]
    }
  }
}
