{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UpBot",
  "version": "0.3.0",
  "identifier": "com.upbot.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd ../.. build:daemon && bun run dev",
    "beforeBuildCommand": "bun run --cwd ../.. build:daemon && bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "UpBot",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*; frame-src http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "externalBin": ["binaries/upbotd"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NDQzMTNGODBGMTEzRkMKUldUOEUvR0FQekZFZEp0YlZIaUFnalBaNHppSWZ2b0VLQ1dSdVlvV25hZVE1M1llYzZMRUF6cHYK",
      "endpoints": [
        "https://github.com/fazedordecodigo/bobagent/releases/latest/download/latest.json"
      ]
    }
  }
}
