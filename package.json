{
  "name": "upbot",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run build:daemon && bun run --cwd apps/desktop tauri dev",
    "build:daemon": "bun build --compile --minify --target=bun-darwin-arm64 packages/daemon/src/main.ts --outfile apps/desktop/src-tauri/binaries/upbotd-aarch64-apple-darwin",
    "build:app": "bun run build:daemon && bun run --cwd apps/desktop tauri build --debug --bundles app",
    "test": "bun test packages/daemon packages/host apps/desktop/test",
    "test:firecracker": "UPBOT_REAL_FIRECRACKER=1 bun test packages/host/test/firecracker.real.test.ts packages/daemon/test/firecracker-ssh.real.test.ts",
    "test:firecracker:providers": "UPBOT_REAL_FIRECRACKER=1 UPBOT_REAL_PROVIDERS=1 bun test packages/host/test/firecracker.real.test.ts packages/daemon/test/firecracker-ssh.real.test.ts",
    "lint": "biome check .",
    "typecheck": "tsc -p packages/protocol/tsconfig.json && tsc -p packages/daemon/tsconfig.json && tsc -p packages/relay/tsconfig.json && tsc -p packages/host/tsconfig.json && tsc -p apps/desktop/tsconfig.json",
    "smoke:ui": "bun scripts/ui-smoke.ts",
    "relay": "bun packages/relay/src/main.ts"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.9.0",
    "@biomejs/biome": "2.5.15",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2"
  }
}
