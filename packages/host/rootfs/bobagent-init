#!/bin/sh
# PID 1 inside a BobAgent Firecracker microVM. The guest has no network device: everything
# goes over vsock to the host (CID 2), which runs `bobagent-host run`.
#   vsock 1024 (listen)  -> provider stdio via `bobagent-host guest-exec`
#   /run/bobagent/bridge.sock -> host vsock 5000 (bobagent MCP bridge)
#   127.0.0.1:3128      -> host vsock 3128 (HTTPS CONNECT proxy, public destinations only)
set -eu
export PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null || true
mkdir -p /dev/pts /run/bobagent /tmp /workspace && mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /tmp
hostname bobagent-vm
ip link set lo up 2>/dev/null || true
export HOME=/root BOBAGENT_GUEST_PROXY=http://127.0.0.1:3128
export BOBAGENT_GUEST_BRIDGE_SOCKET=/run/bobagent/bridge.sock
socat UNIX-LISTEN:/run/bobagent/bridge.sock,fork,mode=600 VSOCK-CONNECT:2:5000 &
socat TCP-LISTEN:3128,bind=127.0.0.1,fork,reuseaddr VSOCK-CONNECT:2:3128 &
cd /workspace
exec socat VSOCK-LISTEN:1024,fork,reuseaddr EXEC:"bun /opt/bobagent/bobagent-host.ts guest-exec"
